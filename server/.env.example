# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (admin app + Pastor PWA).
CLIENT_URL=http://localhost:5173,http://localhost:5174
# Number of proxy hops between the internet and this Node process (e.g. 1 for
# Render/Railway/Nginx). MUST be set in production: without it, express-rate-limit
# keys on the proxy's IP (one shared bucket for all users) and audit rows record
# the proxy IP instead of the real client. It also decides the scheme of the
# payment-webhook URL published in Admin -> Reconciliation: behind a proxy without
# it, the address shown to a payment provider is published as http://.
# Leave 0 in local development.
TRUST_PROXY=0

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ba51b5d00a1d1e2b639664b9adc37cd275bd06cac2d10f90dfa9ca8664505973d0050600a2b9cc4b772fe76e84fb79b9
JWT_EXPIRES_IN=30d

# --- Field-level encryption (AES-256-GCM) for donor names/phone numbers ---
# Must be exactly 32 bytes, base64-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=kydcH+HGmDmsmZeLMfzWi5ysEKL4RXK031/yHZzSEps=

# --- Receipt verification (the QR code on every receipt) ---
# The public base URL a printed receipt's QR code points at. It MUST be the
# deployment's real public URL: the code is baked onto paper for the life of the
# receipt, so changing this invalidates nothing but leaves old printouts pointing
# at the address they were printed with.
RECEIPT_VERIFY_BASE_URL=https://cms.vrtchurch.org
# Requests per IP per 15 minutes on the public verification route. Deliberately
# high: a whole congregation scans on the church's own wifi (one shared IP) right
# after a service.
VERIFY_RATE_LIMIT_MAX=1000

# --- Database ---
# PostgreSQL. `docker compose up -d` in server/ starts the matching local
# container — keep this password in step with POSTGRES_PASSWORD there.
DATABASE_URL=postgresql://vrt_admin:your_password_here@localhost:5432/vrt_cms

# --- Seed / bootstrap super admin (only used the first time the DB is created) ---
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@victoryrevival.church
SEED_SUPERADMIN_PASSWORD=ChangeMe_123!
SEED_PASTOR_NAME=Reverend Pastor
SEED_PASTOR_EMAIL=pastor@victoryrevival.church
SEED_PASTOR_PASSWORD=ChangeMe_123!

# --- Email notifications (Nodemailer / SMTP - e.g. SendGrid SMTP relay) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
PASTOR_EMAIL_FROM=notifications@victoryrevival.church

# --- SMS notifications (Africa's Talking) ---
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key
AT_SENDER_ID=VRT_CHURCH
PASTOR_PHONE=+255700000000

# --- Web Push notifications (Pastor PWA) ---
# Generate a keypair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=BGiborQ8LpDTH8XWjTmpRFugQ-5TqaJoBM7y5fVlBPouWVEis-aLKh-X_bonoxEX42GeeYK3gCDIQ15rpLdDxCE

VAPID_PRIVATE_KEY=AUvbTiUI3ihw4opE0iZ8FgZZqRiC0VVHVyj5v4BOovc
VAPID_SUBJECT=mailto:notifications@victoryrevival.church

# --- Rate limiting ---
LOGIN_RATE_LIMIT_MAX=10
